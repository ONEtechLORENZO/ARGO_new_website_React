# Public production URL, used for canonical links, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.example.com

# "Richiedi demo" form → Google Apps Script web app (apps-script/Code.gs), which emails sales@otech.one
# and sends the confirmation to the customer. See apps-script/README.md.
#   DEMO_WEBHOOK_URL    = the web app URL ending in /exec
#   DEMO_WEBHOOK_SECRET = the same long random string saved as DEMO_SECRET in the script's properties
# If DEMO_WEBHOOK_URL is empty, submitting opens the visitor's email app pre-filled for sales@otech.one.
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=
